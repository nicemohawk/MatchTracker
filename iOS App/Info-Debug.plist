<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.nicemohawk.MatchTracker.refresh</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>MatchTracker records sideline video and cuts clips around the moments you logged.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>MatchTracker records sound with your sideline video.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>MatchTracker saves match clips to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>MatchTracker imports the match video you choose and cuts clips around the moments you logged.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
</dict>
</plist>
