<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>WKApplication</key>
	<true/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>com.nicemohawk.MatchTracker</string>
	<key>NSHealthShareUsageDescription</key>
	<string>MatchTracker reads your heart rate and workout data during a match.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>MatchTracker saves your match as a workout in Health.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>MatchTracker uses your location to record your route on the pitch.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>MatchTracker uses your location during a match to record your route on the pitch.</string>
	<!-- WKBackgroundModes (NOT UIBackgroundModes — that's the iOS key) is what lets a watchOS
	     HKWorkoutSession actually start on a physical watch. The simulator doesn't enforce it,
	     so the wrong key passes every sim test while the device refuses the session. -->
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
</dict>
</plist>
